# Datasets live outside the repo and are symlinked into data/. Nothing is downloaded
# automatically; scripts/download_datasets.py prints the commands.
SATQUERY_DATA_ROOT=/media/you/drive/satquery-data

# Checkpoints, caches and eval output. Never inside the repo.
SATQUERY_ARTIFACT_ROOT=/media/you/drive/satquery-artifacts

# Where HuggingFace caches model weights. Set it if $HOME is small: the captioner
# backbone alone is about 8 GB.
HF_HOME=/media/you/drive/hf-cache

# Optional. Unset means TensorBoard, which is the default tracker.
WANDB_API_KEY=
