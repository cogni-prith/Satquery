# Copy to .env and edit. Never commit .env.
#
# Datasets live OUTSIDE the repo and are symlinked into data/. Nothing is downloaded
# automatically; see scripts/download_datasets.py, which prints commands and verifies
# checksums of files already present.
SATQUERY_DATA_ROOT=/absolute/path/to/satquery-data

# Checkpoints, LoRA adapters, eval output and rendered overlays. Gets large.
SATQUERY_ARTIFACT_ROOT=/absolute/path/to/satquery-artifacts

# HuggingFace cache. Point this at a disk with room; EarthDial-4B is several GB.
HF_HOME=/absolute/path/to/hf-cache

# Optional. When set, training logs to Weights and Biases instead of TensorBoard.
# See satquery.utils.logging.tracker_backend().
WANDB_API_KEY=
